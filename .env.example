# Copy to .env (never commit .env). Backend reads these; frontend reads only VITE_* vars and API_PROXY_TARGET.

# ---- LLM ----
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-flash-latest
# Comma-separated, tried in order on the same key when GEMINI_MODEL is overloaded (503, skipped 60 s) or out of quota
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
# Must be a vision-capable model pulled on the Mac, e.g. gemma3:4b or qwen2.5vl:7b (check RAM)
OLLAMA_MODEL=gemma3:4b
OLLAMA_TEXT_MODEL=gemma3:4b
LLM_TIMEOUT_S=30

# ---- Backend ----
# real = engine/ ; stub = shared/engine_stub.py (tests only)
ENGINE_MODE=real
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_DIR=.cache
MAX_IMAGES=3
MAX_IMAGE_MB=8
# Parallel OCR runs; set 1 on small hosts (e.g. Render free)
OCR_WORKERS=3
# One scan end to end, and reading the text of one photo (seconds). Slow hosts need more:
# Render free (0.1 CPU) takes ~30 s just to read a photo, so use SCAN_BUDGET_S=150, OCR_TIMEOUT_S=100 there.
SCAN_BUDGET_S=45
OCR_TIMEOUT_S=30
LOG_LEVEL=info

# ---- Frontend (Vite) ----
# Empty = same-origin /api, forwarded by Vite to API_PROXY_TARGET (needed for the phone / cloudflared).
# Set it only for a deployed frontend (the deployed backend's URL).
VITE_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8000
# true = use shared/fixtures, no backend needed
VITE_USE_MOCKS=false
# How long the app waits for a scan (seconds). Keep it above the backend's SCAN_BUDGET_S (e.g. 180 for Render free).
VITE_SCAN_TIMEOUT_S=60
