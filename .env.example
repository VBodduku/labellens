# Copy to .env (never commit .env). Backend reads these; frontend reads only VITE_* vars.

# ---- LLM ----
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://localhost:11434
# Must be a vision-capable model pulled on the Mac, e.g. gemma3:4b or qwen2.5vl:7b (check RAM)
OLLAMA_MODEL=gemma3:4b
OLLAMA_TEXT_MODEL=gemma3:4b
LLM_TIMEOUT_S=30

# ---- Backend ----
# stub until Part 3 is merged, then real
ENGINE_MODE=stub
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_DIR=.cache
MAX_IMAGES=3
MAX_IMAGE_MB=8
LOG_LEVEL=info

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000
# true = use shared/fixtures, no backend needed
VITE_USE_MOCKS=true
